<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- .NET 10 only ships _framework/blazor.server.js as a static web asset when the
         project itself contains a .razor file; all components live in BTCPayApp.UI, so
         force inclusion or the script 404s and the circuit never starts. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BTCPayApp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
  	<ProjectReference Include="..\BTCPayApp.Core\BTCPayApp.Core.csproj" />
  	<ProjectReference Include="..\BTCPayApp.Desktop\BTCPayApp.Desktop.csproj" />
    <ProjectReference Include="..\BTCPayApp.UI\BTCPayApp.UI.csproj" />
  </ItemGroup>

</Project>
